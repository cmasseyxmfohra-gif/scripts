local function Tween(Obj, Time, Props)
    local T = TweenService:Create(Obj, TweenInfo.new(Time, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), Props)
    T:Play()
    return T
end

Btn.MouseEnter:Connect(function() Tween(Btn, 0.15, {BackgroundColor3 = Theme.Accent:Lerp(Color3.new(1, 1, 1), 0.15)}) end)
Btn.MouseLeave:Connect(function() Tween(Btn, 0.15, {BackgroundColor3 = Theme.Accent}) end)
